; Engine configuration file.
; CGPSC Study Garden — premium milestone visualizer
config_version=5

[application]

config/name="CGPSC Study Garden"
config/description="Living garden that grows with every 4-day study milestone"
run/main_scene="res://scenes/GardenScene.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]

GardenManager="*res://scripts/GardenManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/min_width=640
window/size/min_height=360
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]

renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=2
environment/defaults/default_clear_color=Color(0.35, 0.55, 0.72, 1)

[input]

refresh_garden={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":82,"key_label":0,"unicode":114,"location":0,"echo":false,"script":null)
]
}

[network]

limits/debugger/max_chars_per_second=32768
